    "workspace": {
      "files": {
        "${mod}.py": "import yaml\n\n\ndef ${func}(text):\n    return yaml.load(text)\n"
      }
    },
    "steps": [
      {
        "capability": "artifact.repair",
        "request": {},
        "dat": {
          "fail_on": "medium",
          "profile": "security"
        }
      },
      {
        "command": "dat",
        "fail_on": "medium",
        "profile": "security"
      }
    ]
  },
  "variants": [
    {
      "id": "01",
      "params": {
        "mod": "settings",
        "func": "parse_settings"
      }
    },
    {
      "id": "02",
      "params": {
        "mod": "manifest",
        "func": "read_manifest"
      }
    },
    {
      "id": "03",
      "params": {
        "mod": "fixtures",
        "func": "load_fixture"
      }
    }
  ]
}
