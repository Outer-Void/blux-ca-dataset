{
  "schema": "blux.dataset-seed",
  "family": "sec-yaml-load",
  "category": "security-repair",
  "split": "train",
  "origin": "synthetic-authored",
  "review": {
    "status": "approved",
    "reviewer": "outer-void"
  },
  "tags": [
    "security",
    "dat"
  ],
  "instruction": "DAT flags yaml.load in ${mod}.py as unsafe deserialization. Run DAT, let cA repair what DAT reported, and re-run DAT.",
